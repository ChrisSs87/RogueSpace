[sub_resource type="Resource" id="RoomTurnRoomForbidden"]
script = ExtResource("4_constraint")
selector_pattern = [&"ROOM", &"TURN", &"ROOM"]
description = "A wide room cannot immediately follow a turn whose entrance follows a wide room; require an intervening compatible module."

[resource]
script = ExtResource("1_template")
stable_id = &"TEST_ROOM_BRANCH_HEAVY"
theme_id = &"TEST"
min_modules = 7
max_modules = 10
min_main_path_depth = 4
grammar_rules = [SubResource("RuleCorridor"), SubResource("RuleRoom"), SubResource("RuleLeft"), SubResource("RuleRight"), SubResource("RuleJunction"), SubResource("RuleSide")]
forbidden_role_sequences = [SubResource("RoomTurnRoomForbidden")]
module_pool = [SubResource("Start"), SubResource("Exit"), SubResource("Corridor"), SubResource("Room"), SubResource("RoomCompact"), SubResource("TurnLeft"), SubResource("TurnRight"), SubResource("Junction"), SubResource("Side"), SubResource("SideCompact")]
content_profile_id = &"TEST_NONE"
