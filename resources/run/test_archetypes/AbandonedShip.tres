[sub_resource type="Resource" id="Small"]
script = ExtResource("4")
size_id = &"SMALL"
display_name = "Small"
selection_weight = 1.0
min_modules = 11
max_modules = 11
role_min_counts = {"CORRIDOR": 4, "ROOM": 1, "JUNCTION": 2}
role_max_counts = {"CORRIDOR": 6, "ROOM": 1, "JUNCTION": 2}
min_reconnections = 0
max_reconnections = 0

[sub_resource type="Resource" id="Medium"]
script = ExtResource("4")
size_id = &"MEDIUM"
display_name = "Medium"
selection_weight = 2.0
min_modules = 14
max_modules = 14
role_min_counts = {"CORRIDOR": 4, "ROOM": 2, "JUNCTION": 3}
role_max_counts = {"CORRIDOR": 7, "ROOM": 3, "JUNCTION": 3}
min_reconnections = 1
max_reconnections = 1

[sub_resource type="Resource" id="Large"]
script = ExtResource("4")
size_id = &"LARGE"
display_name = "Large"
