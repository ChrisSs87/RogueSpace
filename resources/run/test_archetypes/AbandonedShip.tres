max_reconnections = 1

[sub_resource type="Resource" id="Deck"]
script = ExtResource("2")
sector_id = &"DECK"
display_name = "Deck"
template_pool = [ExtResource("3")]
size_profiles = [SubResource("Small"), SubResource("Medium"), SubResource("Large")]
light_profile_id = &"LOW_OFFLINE"
population_profile_id = &"LOW_MEDIUM"
population_density = 0.35
allowed_enemy_faction_tags = [&"HORVEX", &"VARKHEM", &"MYKORA"]
preferred_room_roles = [&"STORAGE", &"MEDBAY", &"CREW_ROOM", &"ENGINE_ROOM", &"BRIDGE"]
semantic_locations = [ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11")]

[resource]
script = ExtResource("1")
archetype_id = &"ABANDONED_SHIP"
display_name = "Abandoned Ship"
sector_count_min = 1
sector_count_max = 1
sectors = [SubResource("Deck")]
allowed_enemy_faction_tags = [&"HORVEX", &"VARKHEM", &"MYKORA"]
light_profile_id = &"LOW_OFFLINE"
population_profile_id = &"LOW_MEDIUM"
population_density = 0.35
preferred_room_roles = [&"STORAGE", &"MEDBAY", &"CREW_ROOM", &"ENGINE_ROOM", &"BRIDGE"]
