[gd_resource type="Resource" script_class="BiomeLightingProfileResource" load_steps=9 format=3]
[ext_resource type="Script" path="res://resources/run/BiomeLightingProfileResource.gd" id="1"]
[ext_resource type="Script" path="res://resources/run/LightingVariantResource.gd" id="2"]
[ext_resource type="Resource" path="res://resources/lighting/bioluminescence.tres" id="3"]
[ext_resource type="Resource" path="res://resources/lighting/natural_opening.tres" id="4"]
[ext_resource type="Resource" path="res://resources/lighting/luminous_tissue.tres" id="5"]

[sub_resource type="Resource" id="OPERATIVA"]
script = ExtResource("2")
stable_id = &"OPERATIVA"
allowed_sources = Array[StringName]([&"bioluminescence", &"natural_opening", &"luminous_tissue"])
activation_probability = 1
power_multiplier = 1
override_color = false
color = Color(1, 0.12, 0.08, 1)

[sub_resource type="Resource" id="REDUCIDA"]
script = ExtResource("2")
stable_id = &"REDUCIDA"
allowed_sources = Array[StringName]([&"bioluminescence", &"natural_opening", &"luminous_tissue"])
activation_probability = 0.65
power_multiplier = 0.8
override_color = false
color = Color(1, 0.12, 0.08, 1)

[sub_resource type="Resource" id="EMERGENCIA"]
script = ExtResource("2")
stable_id = &"EMERGENCIA"
allowed_sources = Array[StringName]([&"bioluminescence", &"natural_opening", &"luminous_tissue"])
activation_probability = 0.5
power_multiplier = 0.6
override_color = true
color = Color(1, 0.12, 0.08, 1)

[resource]
script = ExtResource("1")
stable_id = &"HORVEX_LIGHTING"
architecture_id = &"HORVEX_NEST"
ambient = 1.0
max_visual_lights = 8
sources = [ExtResource("3"), ExtResource("4"), ExtResource("5")]
variants = [SubResource("OPERATIVA"), SubResource("REDUCIDA"), SubResource("EMERGENCIA")]
default_variant = &"OPERATIVA"

